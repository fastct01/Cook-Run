# dependencies (Render runs `npm install` on every deploy)
node_modules/

# generated by `npm install` → scripts/copy-vendor.js (postinstall); never commit it
public/vendor/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# logs
npm-debug.log*
*.log

# local env
.env
.env.*

# docs scratch (keep the curated screenshots in docs/)
docs/scratch/
docs/tmp/
docs/*.tmp.png

# full set of test screenshots (large); curated ones stay in docs/
docs/screenshots-dev/
